<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Library instrumentation has its own application, separate from Expo's
       generated app manifest. Exercise the real provider through its resolver. -->
  <application>
    <provider
      android:name="com.moxbots.mobile.remote.NativeArtifactProvider"
      android:authorities="${applicationId}.moxbots.artifacts"
      android:exported="false"
      android:grantUriPermissions="true" />
  </application>
</manifest>
